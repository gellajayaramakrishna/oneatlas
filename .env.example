# PostgreSQL connection used by the app at runtime.
# On Neon, use the POOLED connection string here (host contains "-pooler").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneatlas"

# Direct (non-pooled) connection used by `prisma migrate`.
# Locally this is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oneatlas"

# Bearer token for POST /api/admin/ingest. Use a long random string in production.
ADMIN_TOKEN="change-me"

# Optional: max connections per server instance (default 5).
# DB_POOL_SIZE=5
